{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Unity Project Sync",
  "version": "0.1.0",
  "identifier": "de.umami.unityprojectsync",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Unity Project Sync",
        "width": 980,
        "height": 760,
        "minWidth": 760,
        "minHeight": 620,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Umami Creative GmbH",
    "copyright": "© 2026 Umami Creative GmbH",
    "category": "DeveloperTool",
    "shortDescription": "Mirror the non-regenerable parts of Unity projects",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "German"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "compression": "lzma"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
